# Copy to .env.local. Keep your existing .env.local when updating the project.
# Real database: choose postgresql, fill DATABASE_URL, then run npm run db:upgrade.
# Local demo: choose demo; DATABASE_URL is not used by the academic portal in demo mode.
PORTAL_STORAGE="demo"
DATABASE_URL="postgresql://neondb_owner:YOUR_NEON_PASSWORD@ep-xyz.neon.tech/neondb?sslmode=require"

# Academic dashboard defaults; semester is explicit and is never inferred from its name.
PORTAL_CURRENT_SEMESTER="HK1 2026-2027"
# Optional ISO timestamps, for example 2026-09-01T08:00:00+07:00.
PORTAL_GRADE_ENTRY_START=""
PORTAL_GRADE_ENTRY_END=""

# Generate a private value: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Required for npm start / production; also set it for stable development sessions.
AUTH_SECRET=""

# Only used on the first real database upgrade if a usable Admin does not exist.
# No default passwords are injected into a real database.
BOOTSTRAP_ADMIN_USERNAME="admin@ptit"
BOOTSTRAP_ADMIN_EMAIL="admin@ptit.edu.vn"
BOOTSTRAP_ADMIN_PASSWORD=""
# Optional: create the first Academic Affairs account (giaovu@ptit).
BOOTSTRAP_ACADEMIC_PASSWORD=""

# Optional for a reverse proxy: the public origin, e.g. https://your-domain.example
# APP_ORIGIN="https://your-domain.example"
