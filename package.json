{
  "name": "ptit-student-portal",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "seed": "prisma db seed",
    "seed:neon": "node scripts/seed-neon.mjs",
    "postinstall": "prisma generate",
    "db:upgrade": "node --import tsx scripts/portal-migrate.ts",
    "db:validate": "prisma validate",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "node --import tsx scripts/verify-desktop-workflow.mjs"
  },
  "prisma": {
    "seed": "ts-node --compiler-options {\"module\":\"CommonJS\"} prisma/seed.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^0.10.4",
    "@prisma/client": "^5.22.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.453.0",
    "next": "^14.2.15",
    "pg": "^8.23.1",
    "proper-lockfile": "^4.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "string_decoder": "^1.3.0",
    "tailwind-merge": "^2.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.11",
    "@netlify/plugin-nextjs": "^5.15.13",
    "@types/node": "^20.17.0",
    "@types/pg": "^8.23.1",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.15",
    "postcss": "^8.4.47",
    "prisma": "^5.22.0",
    "puppeteer-core": "^25.10.0",
    "tailwindcss": "^3.4.14",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
